<style>

:root{
  --rust:#8B3A2A;--rl:#C05A3A;
  --dark:#1E0F08;--mid:#2C1F17;
  --off:#F7F3EF;--warm:#EDE5DA;
  --border:#DDD5C8;--muted:#8A7060;
  --card-bg:#241409;--card-border:rgba(192,90,58,.18)
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--dark);color:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}

/* ── NAV ── */
.site-nav{
  position:sticky;top:0;z-index:999;height:68px;
  padding:0 5%;display:flex;align-items:center;justify-content:space-between;
  background:rgba(30,15,8,.97);backdrop-filter:blur(20px);
  border-bottom:2px solid var(--rl);box-shadow:0 2px 20px rgba(0,0,0,.4)
}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:.18em;color:#fff}
.nav-logo span{color:var(--rl)}
.nav-links{display:flex;gap:1.8rem;list-style:none;align-items:center}
.nav-links a{font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);transition:.2s}
.nav-links a:hover{color:var(--rl)}
.nav-cta{background:var(--rl);color:#fff!important;padding:.45rem 1.3rem;border-radius:2px}
.nav-cta:hover{background:var(--rust)!important}
.nav-icons{display:flex;align-items:center;gap:.8rem}
.nav-icon-btn{background:none;border:1.5px solid rgba(255,255,255,.15);width:38px;height:38px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);transition:.2s;position:relative}
.nav-icon-btn:hover{border-color:var(--rl);color:var(--rl)}
.cart-badge{position:absolute;top:-5px;right:-5px;background:var(--rl);color:#fff;border-radius:50%;width:17px;height:17px;font-size:.58rem;font-weight:700;display:none;align-items:center;justify-content:center}
.cart-badge.show{display:flex}
.ham{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer}
.ham span{width:22px;height:2px;background:rgba(255,255,255,.7);border-radius:2px;transition:.3s}
.mob-nav{display:none;position:fixed;top:68px;left:0;right:0;background:rgba(30,15,8,.98);padding:1.3rem 5%;z-index:998;flex-direction:column;gap:.9rem;border-bottom:2px solid rgba(192,90,58,.25)}
.mob-nav.open{display:flex}
.mob-nav a{font-size:.85rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6);padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.07)}

/* ── STICKY SCROLL CTA ── */
.sticky-cta{
  position:fixed;bottom:0;left:0;right:0;z-index:888;
  background:rgba(30,15,8,.96);backdrop-filter:blur(12px);
  border-top:2px solid var(--rl);padding:.9rem 5%;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  transform:translateY(100%);transition:transform .4s cubic-bezier(.4,0,.2,1)
}
.sticky-cta.visible{transform:translateY(0)}
.sticky-cta-txt{font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:.06em;color:rgba(255,255,255,.7)}
.sticky-cta-txt strong{color:#fff}
.sticky-cta-btns{display:flex;gap:.7rem;flex-shrink:0}


/* ── HERO ── */
.hero{position:relative;overflow:hidden;min-height:90vh;display:flex;align-items:center;background:var(--dark)}
.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.45}
.hero-ov{position:absolute;inset:0;background:linear-gradient(115deg,rgba(30,15,8,.97) 0%,rgba(30,15,8,.75) 45%,rgba(30,15,8,.2) 100%)}
.hero-inner{position:relative;z-index:2;padding:0 8%;max-width:820px}
.hero-kicker{font-size:.66rem;font-weight:700;letter-spacing:.38em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:1.3rem;display:flex;align-items:center;gap:.75rem}
.hero-kicker::before{content:'';width:26px;height:1.5px;background:var(--rl)}
.hero-h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(3.8rem,7.5vw,7.2rem);line-height:.88;letter-spacing:.02em;color:#fff;margin-bottom:1.4rem}
.hero-h1 em{color:var(--rl);font-style:normal;display:block}
.hero-p{font-size:clamp(.9rem,1.3vw,1.05rem);color:rgba(255,255,255,.5);line-height:1.8;max-width:480px;margin-bottom:2.5rem;font-weight:300}
.hero-btns{display:flex;gap:.9rem;flex-wrap:wrap;margin-bottom:3rem}
.btn-p{display:inline-flex;align-items:center;gap:.5rem;background:var(--rl);color:#fff;padding:.88rem 2rem;border-radius:2px;font-family:'Bebas Neue',sans-serif;font-size:.95rem;letter-spacing:.14em;transition:.2s;cursor:pointer;border:none}
.btn-p:hover{background:var(--rust);transform:translateY(-1px)}
.btn-o{display:inline-flex;align-items:center;gap:.5rem;border:2px solid rgba(255,255,255,.22);color:rgba(255,255,255,.75);padding:.88rem 1.7rem;border-radius:2px;font-family:'Bebas Neue',sans-serif;font-size:.95rem;letter-spacing:.14em;transition:.2s;cursor:pointer;background:none}
.btn-o:hover{border-color:var(--rl);color:var(--rl)}
/* Mini stats en hero */
.hero-mini-stats{display:flex;gap:2.5rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.1)}
.hms{text-align:left}
.hms-n{font-family:'Bebas Neue',sans-serif;font-size:2.4rem;color:#fff;line-height:1}
.hms-n span{color:var(--rl)}
.hms-l{font-size:.62rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.3)}

/* ── TRUST BAR ── */
.trust-bar{background:var(--rl);padding:.9rem 5%;display:flex;align-items:center;justify-content:center;gap:2.5rem;flex-wrap:wrap}
.ti{display:flex;align-items:center;gap:.55rem;color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.ti svg{opacity:.82}
.t-sep{width:1px;height:18px;background:rgba(255,255,255,.22)}

/* ── SECTIONS ── */
.sec{padding:5.5rem 5%}
.sec-dark{background:var(--dark)}
.sec-mid{background:var(--mid)}
.sec-card{background:var(--card-bg)}
.wrap{max-width:1320px;margin:0 auto}
.eyebrow{font-size:.64rem;font-weight:700;letter-spacing:.32em;text-transform:uppercase;color:var(--rl);margin-bottom:.65rem;display:flex;align-items:center;gap:.6rem}
.eyebrow::before{content:'';width:20px;height:1.5px;background:var(--rl)}
.sec-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,4vw,3.4rem);line-height:.93;letter-spacing:.03em;color:#fff}
.sec-h em{color:var(--rl);font-style:normal}
.sec-lead{font-size:.96rem;color:rgba(255,255,255,.45);line-height:1.78;font-weight:300;margin-top:.7rem;max-width:540px}
.sec-head{margin-bottom:3rem}
.sec-head.center{text-align:center}
.sec-head.center .eyebrow{justify-content:center}
.sec-head.center .eyebrow::before{display:none}
.sec-head.center .sec-lead{margin:0 auto;margin-top:.7rem}

/* ── FILTER TABS ── */
.filter-wrap{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2rem}
.filter-btn{font-family:'Bebas Neue',sans-serif;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);border:1.5px solid rgba(255,255,255,.1);padding:.45rem 1.1rem;border-radius:2px;cursor:pointer;transition:.2s}
.filter-btn:hover{border-color:var(--rl);color:rgba(255,255,255,.85)}
.filter-btn.active{background:var(--rl);border-color:var(--rl);color:#fff}

/* ── PRODUCT GRID ── */
.p-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem}
.p-card{background:var(--card-bg);border:1.5px solid var(--card-border);border-radius:8px;overflow:hidden;cursor:pointer;transition:border-color .25s,box-shadow .25s,transform .25s}
.p-card:hover{border-color:var(--rl);box-shadow:0 8px 30px rgba(192,90,58,.15);transform:translateY(-3px)}
.p-card.hidden{display:none}
.p-img-wrap{position:relative;aspect-ratio:1;overflow:hidden}
.p-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .45s}
.p-card:hover .p-img-wrap img{transform:scale(1.06)}
.p-tag{position:absolute;top:.55rem;left:.55rem;font-family:'Bebas Neue',sans-serif;font-size:.6rem;letter-spacing:.14em;color:#fff;padding:.2rem .55rem;border-radius:2px;z-index:2}
.p-overlay{position:absolute;inset:0;background:rgba(30,15,8,.55);display:flex;align-items:center;justify-content:center;opacity:0;transition:.3s}
.p-card:hover .p-overlay{opacity:1}
.p-cot-btn{font-family:'Bebas Neue',sans-serif;font-size:.8rem;letter-spacing:.16em;background:var(--rl);color:#fff;border:none;padding:.5rem 1.2rem;border-radius:2px;cursor:pointer;transition:.2s}
.p-cot-btn:hover{background:var(--rust)}
.p-body{padding:.85rem .9rem .95rem}
.p-nombre{font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:.05em;color:#fff;margin-bottom:.15rem;line-height:1.1}
.p-comp{font-size:.65rem;color:rgba(255,255,255,.4);line-height:1.35;margin-bottom:.55rem}
.p-footer{display:flex;align-items:center;justify-content:space-between}
.p-precio{font-family:'Bebas Neue',sans-serif;font-size:1.12rem;color:var(--rl);letter-spacing:.04em}
.p-col{font-size:.62rem;color:rgba(255,255,255,.35);font-weight:600;letter-spacing:.06em}

/* ── CATEGORÍAS VISUALES ── */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.cat-card{position:relative;border-radius:8px;overflow:hidden;aspect-ratio:3/4;display:block;border:1.5px solid var(--card-border);transition:.3s}
.cat-card:hover{border-color:var(--rl);transform:translateY(-3px)}
.cat-card img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.cat-card:hover img{transform:scale(1.07)}
.cat-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(30,15,8,.92) 0%,rgba(30,15,8,.3) 55%,transparent 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:1.3rem 1.1rem}
.cat-ttl{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:.06em;color:#fff;line-height:1;margin-bottom:.3rem}
.cat-sub{font-size:.7rem;color:rgba(255,255,255,.55);line-height:1.4;margin-bottom:.7rem}
.cat-link{display:inline-flex;align-items:center;gap:.35rem;font-family:'Bebas Neue',sans-serif;font-size:.7rem;letter-spacing:.14em;color:var(--rl);transition:.2s}
.cat-card:hover .cat-link{color:#fff}

/* ── ABOUT ── */
.about-wrap{max-width:760px;margin:0 auto;text-align:left}
.about-tabs{display:flex;gap:.5rem;margin-bottom:2rem}
.atab{font-family:'Bebas Neue',sans-serif;font-size:.8rem;letter-spacing:.14em;background:rgba(255,255,255,.06);color:rgba(255,255,255,.45);border:1.5px solid rgba(255,255,255,.1);padding:.45rem 1.1rem;border-radius:2px;cursor:pointer;transition:.2s}
.atab.active{background:var(--rl);border-color:var(--rl);color:#fff}
.atab:hover:not(.active){border-color:rgba(255,255,255,.25);color:rgba(255,255,255,.8)}
.atab-panel{display:none}
.atab-panel.active{display:block}
.about-q{font-family:'DM Serif Display',serif;font-size:1.2rem;font-style:italic;color:rgba(192,90,58,.85);line-height:1.58;margin-bottom:1.3rem;padding-left:1.1rem;border-left:3px solid var(--rl)}
.about-p{font-size:.92rem;color:rgba(255,255,255,.55);line-height:1.82;margin-bottom:1.3rem}
.checks{display:flex;flex-direction:column;gap:.55rem;margin-bottom:1.8rem}
.ch{display:flex;align-items:center;gap:.65rem;font-size:.84rem;font-weight:500;color:rgba(255,255,255,.65)}
.ch svg{color:var(--rl);flex-shrink:0}
.info-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.ic{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:8px;padding:1.3rem}
.ic-icon{color:var(--rl);margin-bottom:.65rem}
.ic-title{font-family:'Bebas Neue',sans-serif;font-size:.95rem;letter-spacing:.08em;color:#fff;margin-bottom:.3rem}
.ic-text{font-size:.78rem;color:rgba(255,255,255,.45);line-height:1.6}

/* ── NÚMEROS (contador animado) ── */
.nums-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1.5px solid rgba(192,90,58,.2);border-radius:10px;overflow:hidden}
.num-cell{text-align:center;padding:2.8rem 1rem;border-right:1px solid rgba(192,90,58,.15);transition:.3s}
.num-cell:last-child{border-right:none}
.num-cell:hover{background:rgba(192,90,58,.06)}
.num-v{font-family:'Bebas Neue',sans-serif;font-size:3.5rem;color:var(--rl);line-height:1}
.num-l{font-size:.62rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-top:.35rem}

/* ── MAYOREO ── */
.mayoreo-wrap{position:relative;border-radius:12px;overflow:hidden;min-height:420px;display:flex;align-items:center;border:1.5px solid rgba(192,90,58,.2)}
.mayoreo-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.mayoreo-ov{position:absolute;inset:0;background:linear-gradient(108deg,rgba(30,15,8,.95) 0%,rgba(30,15,8,.72) 52%,rgba(30,15,8,.18) 100%)}
.mayoreo-content{position:relative;z-index:2;padding:3.2rem}
.pps{display:flex;gap:.85rem;flex-wrap:wrap;margin-top:1.6rem}
.pp{background:rgba(255,255,255,.07);border:1px solid rgba(192,90,58,.3);border-radius:5px;padding:.85rem 1.2rem;text-align:center;backdrop-filter:blur(4px);transition:.2s}
.pp:hover{background:rgba(192,90,58,.15);border-color:var(--rl)}
.pp-v{font-family:'Bebas Neue',sans-serif;font-size:1.65rem;color:var(--rl);letter-spacing:.04em;line-height:1}
.pp-l{font-size:.58rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.38);margin-top:.2rem}

/* ── TICKER ── */
.ticker{background:rgba(255,255,255,.03);overflow:hidden;padding:.5rem 0;border-top:1px solid rgba(192,90,58,.12);border-bottom:1px solid rgba(192,90,58,.12)}
.ticker-t{display:flex;width:max-content;animation:tk 26s linear infinite}
.ticker-t:hover{animation-play-state:paused}
.ticker-i{font-family:'Bebas Neue',sans-serif;font-size:.75rem;letter-spacing:.22em;color:rgba(255,255,255,.28);padding:0 1.8rem;white-space:nowrap}
.ticker-d{color:var(--rl)}
@keyframes tk{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── TESTIMONIOS ── */
.rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.rev-card{background:var(--card-bg);border:1.5px solid var(--card-border);border-radius:9px;padding:1.7rem 1.5rem;transition:.3s}
.rev-card:hover{border-color:rgba(192,90,58,.4)}
.rev-stars{color:var(--rl);font-size:.82rem;margin-bottom:.65rem}
.rev-text{font-size:.84rem;color:rgba(255,255,255,.5);line-height:1.7;margin-bottom:1rem;font-style:italic}
.rev-name{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#fff}
.rev-tela{font-size:.66rem;color:rgba(255,255,255,.3);margin-top:.1rem}

/* ── BLOG ── */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.blog-card{background:var(--card-bg);border:1.5px solid var(--card-border);border-radius:9px;overflow:hidden;transition:.3s;display:block}
.blog-card:hover{border-color:rgba(192,90,58,.4);transform:translateY(-3px)}
.blog-body{padding:1.4rem}
.blog-cat{font-size:.62rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--rl);margin-bottom:.5rem}
.blog-t{font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:.04em;color:#fff;margin-bottom:.4rem;line-height:1.12}
.blog-ex{font-size:.78rem;color:rgba(255,255,255,.4);line-height:1.65;margin-bottom:.8rem}
.blog-lnk{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rl)}

/* ── CONTACTO ── */
.cto-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
.map-wrap{border-radius:9px;overflow:hidden;border:1.5px solid var(--card-border)}
.info-list{display:flex;flex-direction:column;gap:.9rem}
.info-row{display:flex;gap:.85rem;align-items:flex-start}
.info-ico{width:38px;height:38px;background:rgba(192,90,58,.12);border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--rl)}
.info-l{font-size:.6rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:.14rem}
.info-v{font-size:.86rem;font-weight:500;color:rgba(255,255,255,.75)}

/* ── FAQ ── */
.faq-list{max-width:740px;margin:0 auto;display:flex;flex-direction:column;gap:.6rem}
.faq-item{background:var(--card-bg);border:1.5px solid var(--card-border);border-radius:7px;overflow:hidden;transition:.2s}
.faq-item:hover{border-color:rgba(192,90,58,.3)}
.faq-item.open{border-color:rgba(192,90,58,.5)}
.faq-q{padding:.95rem 1.2rem;font-weight:600;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:1rem;color:rgba(255,255,255,.75);transition:.2s}
.faq-q:hover{color:#fff}
.faq-q svg{color:var(--rl);flex-shrink:0;transition:.3s}
.faq-a{display:none;padding:0 1.2rem .85rem;font-size:.82rem;color:rgba(255,255,255,.45);line-height:1.72}
.faq-item.open .faq-a{display:block}
.faq-item.open .faq-q svg{transform:rotate(45deg)}
.faq-item.open .faq-q{color:#fff}

/* ── CTA FINAL ── */
.cta-final{text-align:center;padding:5.5rem 5%;background:var(--mid)}

/* ── FOOTER ── */
footer{background:#120A04;padding:3.5rem 5% 1.8rem;border-top:2px solid rgba(192,90,58,.2)}
.f-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:2.5rem;margin-bottom:2.5rem}
.f-name{font-family:'Bebas Neue',sans-serif;font-size:1.7rem;letter-spacing:.18em;color:#fff}
.f-name span{color:var(--rl)}
.f-tag{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.22);margin-bottom:.8rem}
.f-desc{font-size:.76rem;color:rgba(255,255,255,.3);line-height:1.72}
.f-col h4{font-size:.6rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.22);margin-bottom:.85rem}
.f-col ul{list-style:none;display:flex;flex-direction:column;gap:.46rem}
.f-col a{font-size:.76rem;color:rgba(255,255,255,.38);transition:.2s}
.f-col a:hover{color:var(--rl)}
.f-bot{border-top:1px solid rgba(255,255,255,.06);padding-top:1.3rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.8rem}
.f-copy{font-size:.68rem;color:rgba(255,255,255,.2)}
.f-leg{display:flex;gap:1.3rem}
.f-leg a{font-size:.66rem;color:rgba(255,255,255,.2);transition:.2s}
.f-leg a:hover{color:var(--rl)}

/* ── FLOATING BUTTONS ── */
.float-btns{position:fixed;right:1.5rem;bottom:5rem;display:flex;flex-direction:column;gap:.7rem;z-index:889}
.float-btn{width:48px;height:48px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.35);transition:.25s}
.float-btn:hover{transform:scale(1.1)}
.wha-btn{background:#25D366}
.top-btn{background:var(--rl);opacity:0;pointer-events:none}
.top-btn.visible{opacity:1;pointer-events:all}

/* ── CART / MODAL ── */
