<script>


// ══ CARRUSEL TELAS ══
(function(){
  var track = document.getElementById('carousel-track');
  if(!track) return;
  var slides = track.querySelectorAll('.carousel-slide');
  var total = slides.length;
  var current = 0;
  var timer = null;
  var visible = 4;

  function getVisible(){
    if(window.innerWidth <= 380) return 1;
    if(window.innerWidth <= 600) return 2;
    if(window.innerWidth <= 900) return 3;
    return 4;
  }

  function buildDots(){
    var dots = document.getElementById('carousel-dots');
    if(!dots) return;
    dots.innerHTML = '';
    var pages = Math.ceil(total / getVisible());
    for(var i=0; i<pages; i++){
      var d = document.createElement('button');
      d.className = 'carousel-dot' + (i===0?' active':'');
      d.setAttribute('aria-label','Página '+(i+1));
      (function(idx){ d.addEventListener('click', function(){ goTo(idx); }); })(i);
      dots.appendChild(d);
    }
  }

  function updateDots(){
    var dots = document.getElementById('carousel-dots');
    if(!dots) return;
    var v = getVisible();
    var page = Math.floor(current / v);
    dots.querySelectorAll('.carousel-dot').forEach(function(d,i){ d.classList.toggle('active', i===page); });
  }

  function goTo(page){
    var v = getVisible();
    current = page * v;
    if(current >= total) current = 0;
    var offset = current * (100 / total);
    track.style.transform = 'translateX(-' + offset + '%)';
    updateDots();
    resetTimer();
  }

  function goToSlide(idx){
    var v = getVisible();
    if(idx < 0) idx = total - v;
    if(idx > total - v) idx = 0;
    current = idx;
    var offset = current * (100 / total);
    track.style.transform = 'translateX(-' + offset + '%)';
    updateDots();
    resetTimer();
  }

  window.carouselNext = function(){ goToSlide(current + getVisible()); };
  window.carouselPrev = function(){ goToSlide(current - getVisible()); };

  function resetTimer(){ clearInterval(timer); timer = setInterval(window.carouselNext, 3500); }

  // Touch swipe
  var startX = 0;
  track.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; }, {passive:true});
  track.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - startX;
    if(Math.abs(dx) > 50){ dx < 0 ? window.carouselNext() : window.carouselPrev(); }
  }, {passive:true});

  // Pausar al pasar el mouse
  track.addEventListener('mouseenter', function(){ clearInterval(timer); });
  track.addEventListener('mouseleave', function(){ resetTimer(); });

  window.addEventListener('resize', function(){ buildDots(); goToSlide(0); });

  buildDots();
  resetTimer();
})();



// ── SCROLL ANIMATIONS ──
(function(){
  // IntersectionObserver para animaciones de entrada
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('in');
        obs.unobserve(e.target);
      }
    });
  }, {threshold:0.12, rootMargin:'0px 0px -40px 0px'});

  // Aplicar a elementos existentes
  document.querySelectorAll('.sec-head, .cat-card, .rev-card, .blog-card, .faq-item, .about-wrap, .mayoreo-wrap, .nums-grid').forEach(function(el){
    el.classList.add('rv','rv-up');
    obs.observe(el);
  });

  // Stagger en grids
  document.querySelectorAll('.cat-grid, .rev-grid, .blog-grid, .pps, .filter-wrap').forEach(function(el){
    el.classList.add('rv-stagger');
    obs.observe(el);
  });

  // Sellos
  var sealObs = new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){
      document.querySelectorAll('.seal').forEach(function(s){ s.classList.add('visible'); });
      sealObs.disconnect();
    }
  }, {threshold:0.2});
  var sealsSection = document.querySelector('.seals-section');
  if(sealsSection) sealObs.observe(sealsSection);

  // Progress bars en mayoreo
  var pbarObs = new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){
      document.querySelectorAll('.pbar-fill').forEach(function(bar){
        bar.style.width = bar.dataset.width;
      });
      pbarObs.disconnect();
    }
  }, {threshold:0.3});
  var mayoreo = document.querySelector('.mayoreo-wrap');
  if(mayoreo) pbarObs.observe(mayoreo);

  // Parallax en hero (sutil)
  var heroBg = document.querySelector('.hero-bg');
  if(heroBg){
    window.addEventListener('scroll', function(){
      var y = window.scrollY;
      heroBg.style.transform = 'translateY(' + (y * 0.25) + 'px)';
    }, {passive:true});
  }

  // Stagger en product cards al cargar y al filtrar
  function staggerCards(){
    var visible = document.querySelectorAll('.p-card:not(.hidden)');
    visible.forEach(function(card, i){
      card.style.opacity = '0';
      card.style.transform = 'translateY(24px)';
      card.style.transition = 'opacity .5s ease ' + (i * 0.04) + 's, transform .5s ease ' + (i * 0.04) + 's';
      setTimeout(function(){
        card.style.opacity = '1';
        card.style.transform = 'none';
      }, 50);
    });
  }
  // Sobreescribir filterProducts para incluir stagger
  var origFilter = window.filterProducts;
  window.filterProducts = function(btn){
    origFilter(btn);
    setTimeout(staggerCards, 10);
  };
  setTimeout(staggerCards, 200);

  // Hover 3D sutil en sellos
  document.querySelectorAll('.seal').forEach(function(seal){
    seal.addEventListener('mousemove', function(e){
      var rect = seal.getBoundingClientRect();
      var cx = rect.left + rect.width/2;
      var cy = rect.top + rect.height/2;
      var dx = (e.clientX - cx) / 8;
      var dy = (e.clientY - cy) / 8;
      seal.querySelector('.seal-ring').style.transform = 'rotateX(' + (-dy) + 'deg) rotateY(' + dx + 'deg) scale(1.06)';
    });
    seal.addEventListener('mouseleave', function(){
      seal.querySelector('.seal-ring').style.transform = '';
    });
  });

  // Cursor personalizado en cards (sutil)
  document.querySelectorAll('.p-card, .cat-card').forEach(function(card){
    card.style.cursor = 'pointer';
  });
})();


// ── CARRUSEL PRODUCTOS ── loop infinito
(function(){
  var track = document.getElementById('cr-track');
  if(!track) return;
  var slides = track.querySelectorAll('.cr-slide');
  var total = slides.length;
  var current = 0;

  function getVisible(){
    var w = window.innerWidth;
    if(w <= 600) return 2;
    if(w <= 900) return 3;
    return 4;
  }

  function maxIdx(){ return total - getVisible(); }

  function goTo(idx, animate){
    var mp = maxIdx();
    if(idx < 0) idx = mp;
    if(idx > mp) idx = 0;
    current = idx;
    if(animate === false){
      track.style.transition = 'none';
    } else {
      track.style.transition = 'transform .55s cubic-bezier(.4,0,.2,1)';
    }
    track.style.transform = 'translateX(-' + (current * 100 / total) + '%)';
    buildDots();
  }

  function next(){ goTo(current + 1); }
  function prev(){ goTo(current - 1); }

  function buildDots(){
    var dotsEl = document.getElementById('cr-dots');
    if(!dotsEl) return;
    var pages = maxIdx() + 1;
    if(dotsEl.children.length !== pages){
      dotsEl.innerHTML = '';
      for(var i = 0; i < pages; i++){
        var d = document.createElement('button');
        d.className = 'cr-dot';
        d.setAttribute('aria-label', 'Página ' + (i+1));
        (function(idx){ d.addEventListener('click', function(){ goTo(idx); }); })(i);
        dotsEl.appendChild(d);
      }
    }
    Array.from(dotsEl.children).forEach(function(d,i){
      d.classList.toggle('active', i === current);
    });
  }

  // Botones manuales (no pausan)
  var prevBtn = document.getElementById('cr-prev');
  var nextBtn = document.getElementById('cr-next');
  if(prevBtn) prevBtn.addEventListener('click', prev);
  if(nextBtn) nextBtn.addEventListener('click', next);

  // Touch swipe (no pausa el auto)
  var startX = 0;
  track.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; }, {passive:true});
  track.addEventListener('touchend', function(e){
    var diff = e.changedTouches[0].clientX - startX;
    if(Math.abs(diff) > 40){ diff < 0 ? next() : prev(); }
  }, {passive:true});

  // Resize
  window.addEventListener('resize', function(){ buildDots(); goTo(Math.min(current, maxIdx()), false); });

  // AUTO — avanza cada 2.2s, sin pausa, sin fin
  buildDots();
  goTo(0, false);
  setInterval(next, 2200);
})();


// ── FAQ ACCORDION ──
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click', function(){
    var item = this.closest('.faq-item') || this.parentElement;
    var isOpen = item.classList.contains('open');
    // Cerrar todos
    document.querySelectorAll('.faq-item').forEach(function(i){ i.classList.remove('open'); });
    // Abrir este si estaba cerrado
    if(!isOpen){ item.classList.add('open'); }
  });
});

</script>
